# ── .NET build output & tooling ───────────────────────
[Bb]in/
[Oo]bj/
[Pp]ublish/
artifacts/
*.user
*.suo
*.userprefs
.vs/
.vscode/
*.Code-workspace
TestResults/
*.trx
*.coverage
*.coveragexml

# ── IDE / editors ─────────────────────────────────────
.idea/
*.iml
*.swp
*.swo
.history/
*.orig
*.rej

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Env / secrets (commit *.example templates only) ───
# Ignore every real env file, re-include checked-in templates.
.env
.env.*
!.env.example
!.env.*.example

# ── ASP.NET dev server / launch profiles ──────────────
**/Properties/launchSettings.json

# ── User secrets / local overrides ────────────────────
**/secrets.json
**/.user-secrets*

# App configuration & secrets — commit the .example template ONLY.
**/appsettings.json
**/appsettings.*.json
!**/appsettings.example.json
*.local
**/*.local.json

# ── Certificates & private keys (never commit) ────────
*.pfx
*.p12
*.pem
*.key
*.crt
*.der

# ── Markdown (all docs/notes omitted per user instruction) ─
*.md

# ── Frontend build output / caches ────────────────────
node_modules/
dist/
dist-ssr/
dev-dist/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ── Excel workbooks (semi-confidential trial data — never tracked) ─
*.xlsx
*.xlsm
*.xlsb
*.xls

# ── Code coverage (generated HTML/Cobertura — local-only) ──
coverage/
*.lcov

# ── Python (STT sidecar & tooling) ────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
.ipynb_checkpoints/

# ── Runtime work data (voice recordings, workbooks — generated) ──
Service/

# ── Logs, scratch files & local databases ─────────────
logs/
*.log
*.bak
*.tmp
*.temp
*.db
*.sqlite
*.sqlite3

# ── Local dev tools (machine-specific — keep out of the repo) ──
scripts/dev/android-preview.ps1
.neon
package-lock.json
