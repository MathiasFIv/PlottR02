<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlottR0._2.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlottR0.2.Api\PlottR0.2.Api.csproj" />
    <ProjectReference Include="..\PlottR0.2.Domain\PlottR0.2.Domain.csproj" />
    <ProjectReference Include="..\PlottR0.2.Contracts\PlottR0.2.Contracts.csproj" />
    <ProjectReference Include="..\PlottR0.2.Repository\PlottR0.2.Repository.csproj" />
    <ProjectReference Include="..\PlottR0.2.Services\PlottR0.2.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit core -->
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />

    <!-- Testcontainers — PostgreSQL in Docker -->
    <PackageReference Include="Testcontainers" Version="4.15.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />

    <!-- Bogus — seedable fake data -->
    <PackageReference Include="Bogus" Version="35.6.1" />

    <!-- FluentAssertions — expressive assertions (optional but recommended) -->
    <PackageReference Include="FluentAssertions" Version="7.1.0" />

    <!-- Coverlet — code coverage collection via the "XPlat Code Coverage" data collector -->
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
