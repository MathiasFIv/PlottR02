{
  "ConnectionStrings": {
    "PlottR02": "Host=<project>-pooler.<region>.aws.neon.tech;Port=5432;Database=neondb;Username=<neon-user>;Password=<neon-password>;SSL Mode=Require;Channel Binding=Require;Timeout=15;Command Timeout=60"
  },
  "AllowedOrigins": [ "http://localhost:5173" ],
  "Auth": {
    "AllowAnonymousSignup": false
  },
  "Jwt": {
    "SecretKey": "REPLACE-WITH-A-RANDOM-32-BYTE-SECRET-IN-PRODUCTION",
    "Issuer": "PlottR02",
    "Audience": "PlottR02-Frontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Storage": {
    "Root": "Service"
  },
  "ObjectStorage": {
    "Enabled": false,
    "Provider": "NeonObjectStorage",
    "Bucket": "<private-bucket-name>",
    "Endpoint": "https://<branch-id>.storage.<region>.aws.neon.tech",
    "Region": "eu-central-1",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "ForcePathStyle": true
  },
  "CloudflareAi": {
    "AccountId": "",
    "ApiToken": "",
    "Model": "@cf/openai/whisper-large-v3-turbo",
    "TimeoutSeconds": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
